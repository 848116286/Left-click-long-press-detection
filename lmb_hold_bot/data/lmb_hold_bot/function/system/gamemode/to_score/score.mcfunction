execute unless score @s lmbhb.vt matches 2.. run scoreboard players add @s lmbhb.vt 1
scoreboard players set @s[gamemode=adventure,scores={lmbhb.vt=2..}] lmbhb.v 0
scoreboard players set @s[gamemode=survival,scores={lmbhb.vt=2..}] lmbhb.v 1
scoreboard players set @s[gamemode=creative,scores={lmbhb.vt=2..}] lmbhb.v 2
scoreboard players set @s[gamemode=spectator,scores={lmbhb.vt=2..}] lmbhb.v 3

